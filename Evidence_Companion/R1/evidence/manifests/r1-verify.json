{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "r1-verify",
    "namespace": "paper-r1"
  },
  "spec": {
    "activeDeadlineSeconds": 600,
    "backoffLimit": 0,
    "completions": 1,
    "parallelism": 1,
    "template": {
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "command": [
              "python",
              "-B",
              "/lab/verify.py",
              "/state/reference/step-0012.json",
              "/state/interrupted/step-0012.json"
            ],
            "image": "python@sha256:b685a4fa58bb19d1814d78a1ec0f0208f351452724f78b20212c984d6e124a34",
            "imagePullPolicy": "IfNotPresent",
            "name": "fixture",
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            },
            "volumeMounts": [
              {
                "mountPath": "/lab",
                "name": "code",
                "readOnly": true
              },
              {
                "mountPath": "/state",
                "name": "state",
                "readOnly": true
              }
            ]
          }
        ],
        "nodeSelector": {
          "kubernetes.io/hostname": "worker-1"
        },
        "restartPolicy": "Never",
        "securityContext": {
          "fsGroup": 10001,
          "runAsGroup": 10001,
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "serviceAccountName": "training-sa",
        "volumes": [
          {
            "configMap": {
              "name": "r1-fixtures"
            },
            "name": "code"
          },
          {
            "name": "state",
            "persistentVolumeClaim": {
              "claimName": "r1-state",
              "readOnly": true
            }
          }
        ]
      }
    }
  }
}
