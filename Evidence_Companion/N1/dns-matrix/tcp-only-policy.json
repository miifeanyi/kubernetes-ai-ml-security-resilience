{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "dns-test-allow",
    "namespace": "n1-edge"
  },
  "spec": {
    "podSelector": {},
    "policyTypes": [
      "Egress"
    ],
    "egress": [
      {
        "to": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "kube-system"
              }
            },
            "podSelector": {
              "matchExpressions": [
                {
                  "key": "k8s-app",
                  "operator": "In",
                  "values": [
                    "kube-dns",
                    "node-local-dns"
                  ]
                }
              ]
            }
          }
        ],
        "ports": [
          {
            "port": 53,
            "protocol": "TCP"
          }
        ]
      }
    ]
  }
}