{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "token-on",
    "namespace": "paper-a1-1795392941"
  },
  "spec": {
    "serviceAccountName": "fixture",
    "automountServiceAccountToken": true,
    "restartPolicy": "Never",
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 10001,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "probe",
        "image": "python:3.13.9-slim-bookworm",
        "command": [
          "sleep",
          "1800"
        ],
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        }
      }
    ]
  }
}